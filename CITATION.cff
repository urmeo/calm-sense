message: "Cite CalmSense when using this software."
type: software
title: "CalmSense: Wearable Stress Classification and Calibration on WESAD"
version: 1.0.0
date-released: 2026-07-03
url: "https://github.com/urmeo/calm-sense"
repository-code: "https://github.com/urmeo/calm-sense"
license: MIT
authors:
