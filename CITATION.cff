cff-version: 1.2.0
message: "Cite CalmSense when using this software."
type: software
title: "CalmSense: Wearable Stress Classification and Calibration on WESAD"
version: 1.0.0
date-released: 2026-07-03
authors:
  - given-names: "urme"
    alias: "urmeo"
    website: "https://github.com/urmeo"
repository-code: "https://github.com/urmeo/calm-sense"
license: MIT
abstract: >-
  CalmSense compares four feature-based classifiers and a 1D CNN on WESAD using
  leave-one-subject-out evaluation. Separate studies examine calibration,
  personalization, wrist recordings, and transfer to PhysioNet Non-EEG.
